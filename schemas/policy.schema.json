{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/donestate/schemas/policy.schema.json",
  "title": "DoneState execution policy",
  "type": "object",
  "required": ["schema", "allowedRepositoryRoots", "allowedExecutables", "deniedArgumentPatterns", "allowedEnvironmentKeys", "trustedVerifierFingerprints", "budgets", "authority"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "donestate.execution-policy.v1" },
    "allowedRepositoryRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "allowedExecutables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "deniedArgumentPatterns": { "type": "array", "items": { "type": "string" } },
    "allowedEnvironmentKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "trustedVerifierFingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
    "budgets": {
      "type": "object",
      "required": ["maxActions", "maxAttemptsPerAction", "maxDurationMs", "maxChangedFiles", "maxOutputBytes"],
      "additionalProperties": false,
      "properties": {
        "maxActions": { "type": "integer", "minimum": 1 },
        "maxAttemptsPerAction": { "type": "integer", "minimum": 1 },
        "maxDurationMs": { "type": "integer", "minimum": 1 },
        "maxChangedFiles": { "type": "integer", "minimum": 0 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "authority": {
      "type": "object",
      "required": ["schema", "grants", "issuedBy", "issuedAt"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "donestate.authority-envelope.v1" },
        "objectiveDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["class", "granted"],
            "additionalProperties": false,
            "properties": {
              "class": { "enum": ["local_read", "local_write", "test", "commit", "push", "open_pr", "merge", "deploy", "publish", "secret_access", "destructive"] },
              "granted": { "type": "boolean" },
              "constraints": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "issuedBy": { "type": "string", "minLength": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
