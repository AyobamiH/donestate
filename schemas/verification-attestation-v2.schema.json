{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/donestate/schemas/verification-attestation-v2.schema.json",
  "title": "DoneState independent verification attestation v2",
  "type": "object",
  "required": ["schema", "runId", "executionSnapshotDigest", "verificationNonce", "handoffDigest", "verificationReportDigest", "decision", "issuedBy", "issuedAt", "evidenceRefs", "signature"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "donestate.verification-attestation.v2" },
    "runId": { "type": "string", "format": "uuid" },
    "executionSnapshotDigest": { "$ref": "#/$defs/digest" },
    "verificationNonce": { "$ref": "#/$defs/digest" },
    "handoffDigest": { "$ref": "#/$defs/digest" },
    "verificationReportDigest": { "$ref": "#/$defs/digest" },
    "decision": { "enum": ["verified", "failed", "uncertain"] },
    "issuedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "signature": {
      "type": "object",
      "required": ["algorithm", "publicKeyPem", "signerFingerprint", "signatureBase64"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "publicKeyPem": { "type": "string", "minLength": 1 },
        "signerFingerprint": { "$ref": "#/$defs/digest" },
        "signatureBase64": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
