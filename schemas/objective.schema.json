{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/donestate/schemas/objective.schema.json",
  "title": "DoneState objective",
  "type": "object",
  "required": ["schema", "goal", "repositoryRoot", "requestedBy", "acceptanceCriteria", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "donestate.objective.v1" },
    "goal": { "type": "string", "minLength": 1 },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["executable", "args"],
      "additionalProperties": false,
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "name", "kind", "authority", "command"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["harness", "command", "validation", "publication"] },
        "authority": {
          "enum": ["local_read", "local_write", "test", "commit", "push", "open_pr", "merge", "deploy", "publish", "secret_access", "destructive"]
        },
        "command": { "$ref": "#/$defs/command" },
        "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
