  "properties": {
    "contractVersion": { "const": "donestate.verification-contract.v2" },
    "report": { "$ref": "https://github.com/AyobamiH/donestate/schemas/verification-report-v1.schema.json" },
    "attestation": { "$ref": "https://github.com/AyobamiH/donestate/schemas/verification-attestation-v2.schema.json" }
  }
}
