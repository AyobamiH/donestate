{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyobamiH/donestate/schemas/verification-response-v2.schema.json",
  "title": "DoneState to OpsTruth verification response contract v2",
  "type": "object",
  "required": ["contractVersion", "report", "attestation"],
