{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "donestate-mcp",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RUN_COORDINATOR", "class_name": "RunCoordinator" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RunCoordinator", "Sandbox"]
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
