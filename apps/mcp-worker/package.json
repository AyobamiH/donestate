{
  "name": "@donestate/mcp-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run types && tsc --noEmit",
    "check": "npm run build && npm test",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev --port 8788",
    "test": "vitest run",
    "types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.9",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  }
}
